
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <BaseOutputPath>..\..\UnityTemplate\Assets\Packages\com.sludgyparrot.shared\Editor\Plugins</BaseOutputPath>
    <UnityVersion Condition="'$(UnityVersion)'==''">2022.3.62f3</UnityVersion>
    <Configurations>Debug;Release;Unity2022;Unity2023</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configurations)'=='Unity2022'">
    <UnityVersion>2022.3.62f3</UnityVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configurations)'=='Unity2023'">
    <UnityVersion>2023.1.20f1</UnityVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Code\Runtime\**" />
    <EmbeddedResource Remove="Code\Runtime\**" />
    <None Remove="Code\Runtime\**" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\ParotCodeEventSystem\ParrotCodeEventSystem.csproj" />
    <ProjectReference Include="..\ParrotCodeExtensions\ParrotCodeExtensions.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="UnityEditor.CoreModule">
      <HintPath>..\..\UnityDLL\2023.1.20f1\UnityEditor.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\UnityDLL\2023.1.20f1\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\UnityDLL\2023.1.20f1\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
