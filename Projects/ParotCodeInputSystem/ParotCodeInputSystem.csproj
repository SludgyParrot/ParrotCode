<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <BaseOutputPath>..\..\Packages\com.sludgyparrot.inputsystem\Runtime\Plugins</BaseOutputPath>
    <UnityVersion Condition="'$(UnityVersion)'==''">2022.3.62f3</UnityVersion>
    <Configurations>Debug;Release;Unity2022;Unity2023</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configurations)'=='Unity2022'">
    <UnityVersion>2022.3.62f3</UnityVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configurations)'=='Unity2023'">
    <UnityVersion>2023.1.20f1</UnityVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParrotNativeCode\ParrotNativeCode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEditor">
      <HintPath>..\..\..\UnityDLL\$(UnityVersion)\UnityEditor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\..\UnityDLL\$(UnityVersion)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
