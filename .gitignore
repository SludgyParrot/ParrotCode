# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/UnityTemplate/[Ll]ibrary/
/UnityTemplate/[Tt]emp/
/[Tt]emp/
/UnityTemplate/[Oo]bj/
/obj/
/UnityTemplate/[Bb]uild/
/UnityTemplate/[Bb]uilds/
/UnityTemplate/[Ll]ogs/
/[Ll]ogs/
/UnityTemplate/[Uu]ser[Ss]ettings/
/UnityTemplate/*.log
/*.log

**/obj/

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
/UnityTemplate/*.blend1
/UnityTemplate/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/UnityTemplate/[Mm]emoryCaptures/

# Recordings can get excessive in size
/UnityTemplate/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/UnityTemplate/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
/UnityTemplate/*.DotSettings.user

# Visual Studio cache directory
/UnityTemplate/.vs/
/.vs/

# Gradle cache directory
/UnityTemplate/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/UnityTemplate/ExportedObj/
/UnityTemplate/.consulo/
/UnityTemplate/*.csproj
/UnityTemplate/*.unityproj
/UnityTemplate/*.sln
/UnityTemplate/*.suo
/UnityTemplate/*.tmp
/UnityTemplate/*.user
/UnityTemplate/*.userprefs
/UnityTemplate/*.pidb
/UnityTemplate/*.booproj
/UnityTemplate/*.svd
/UnityTemplate/*.pdb
/UnityTemplate/*.mdb
/UnityTemplate/*.opendb
/UnityTemplate/*.VC.db

# Unity3D generated meta files
/UnityTemplate/*.pidb.meta
/UnityTemplate/*.pdb.meta
/UnityTemplate/*.mdb.meta

# Unity3D generated file on crash reports
/UnityTemplate/sysinfo.txt

# Mono auto generated files
/UnityTemplate/mono_crash.*

# Builds
/UnityTemplate/*.apk
/UnityTemplate/*.aab
/UnityTemplate/*.unitypackage
/UnityTemplate/*.unitypackage.meta
/UnityTemplate/*.app

# Crashlytics generated file
/UnityTemplate/crashlytics-build.properties

# TestRunner generated files
/UnityTemplate/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/UnityTemplate/ServerData
/UnityTemplate/[Aa]ssets/StreamingAssets/aa*
/UnityTemplate/[Aa]ssets/AddressableAssetsData/link.xml*
/UnityTemplate/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/UnityTemplate/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/UnityTemplate/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/UnityTemplate/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/UnityTemplate/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/UnityTemplate/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/UnityTemplate/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
